{
    "name": "wyzheng/search-model",
    "license": "MIT",
    "type": "library",
    "version": "v1.0.1",
    "description": "扩展 laravel 的 ORM 使其具有简单的搜索功能。",
    "keywords": ["library", "laravel", "search-model"],
    "autoload": {
        "psr-4": {
            "Ugly\\SearchModel\\": "src/"
        }
    },
    "authors": [
        {
            "name": "wyzheng1997",
            "email": "wyzheng1997@163.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/framework": "^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "laravel/pint": "^1.10"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ugly\\SearchModel\\ServiceProvider"
            ]
        }
    }
}
